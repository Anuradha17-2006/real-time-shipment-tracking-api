  <munit:test name="api-console-not-found" description="Exercises the API console not-found response" expectedErrorType="APIKIT:NOT_FOUND">
    <munit:behavior>
      <munit-tools:mock-when processor="apikit:console">
        <munit-tools:then-return>
          <munit-tools:error typeId="APIKIT:NOT_FOUND" />
