  <!-- Shipment processing: known shipment success path. -->
  <munit:test name="shipment-event-known-shipment" description="Stores a new event and updates a known shipment">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Check Duplicate Event" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[]]" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Lookup Shipment" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{shipment_id: 'SHIP-MUNIT-001', carrier_code: 'DELHIVERY', tracking_number: 'DL-MUNIT-001', current_milestone: 'IN_TRANSIT', milestone_rank: 3, promised_delivery: null, estimated_delivery: null, order_id: null, customer_id: null, customer_email: 'munit@example.com', is_delayed: false}]]" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="db:insert">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Insert Tracking Event" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[{affectedRows: 1}]" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="db:update">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Update Shipment Milestone" />
