        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{pending_seq: 403, carrier_code: 'DELHIVERY', tracking_number: '', carrier_event_id: 'MUNIT-NOTRACK-403', raw_payload: '{}', retry_count: 0}]]" mediaType="application/java" />
        </munit-tools:then-return>
