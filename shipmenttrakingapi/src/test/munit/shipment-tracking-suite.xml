  <munit:test name="api-main-unsupported-media-type-handler" description="Exercises global APIKIT 415 handler" expectedErrorType="APIKIT:UNSUPPORTED_MEDIA_TYPE">
    <munit:behavior>
      <munit-tools:mock-when processor="apikit:router">
        <munit-tools:then-return><munit-tools:error typeId="APIKIT:UNSUPPORTED_MEDIA_TYPE" /></munit-tools:then-return>
