  <!-- Webhook: invalid/unsupported carrier is handled without calling the database. -->
  <munit:test name="webhook-rejects-unsupported-carrier" description="Rejects an unsupported carrier">
    <munit:execution>
      <munit:set-event cloneOriginalEvent="false">
        <munit:payload value="#[{}]" />
        <munit:attributes value="#[{uriParams: {carrierCode: 'UNKNOWN'}, headers: {}}]" />
      </munit:set-event>
      <flow-ref name="post:\webhooks\carriers\(carrierCode):application\json:real-time-shipment-tracking-api-config" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[vars.httpStatus]" expected="#[401]" />
      <munit-tools:assert-equals actual="#[payload.received]" expected="#[false]" />
    </munit:validation>
  </munit:test>
  <!-- Delhivery webhook: invalid API key must be rejected before shipment processing. -->
  <munit:test name="webhook-delhivery-invalid-api-key" description="Rejects Delhivery events with an invalid API key">
    <munit:execution>
      <munit:set-event cloneOriginalEvent="false">
        <munit:payload value="#[{waybill: 'DL-MUNIT-INVALID-001', shipment_status: 'OUT FOR DELIVERY'}]" />
        <munit:attributes value="#[{uriParams: {carrierCode: 'DELHIVERY'}, headers: {'x-api-key': 'invalid-munit-key', 'x-carrier-event-id': 'MUNIT-DEL-INVALID-001'}}]" />
      </munit:set-event>
      <flow-ref name="post:\webhooks\carriers\(carrierCode):application\json:real-time-shipment-tracking-api-config" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[vars.httpStatus]" expected="#[401]" />
      <munit-tools:assert-equals actual="#[payload.received]" expected="#[false]" />
      <munit-tools:verify-call processor="db:select" times="0" />
    </munit:validation>
  </munit:test>
  <!-- Delhivery webhook: use the configured key; mock only the database duplicate lookup. -->
  <munit:test name="webhook-delhivery-valid-event" description="Validates and normalizes a Delhivery event">
    <munit:behavior>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Check Duplicate Event" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{event_seq: 1}]]" mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <munit:set-event cloneOriginalEvent="false">
        <munit:payload value="#[{waybill: 'DL-MUNIT-VALID-001', shipment_status: 'OUT FOR DELIVERY', location: {facilityCode: 'MUNIT', city: 'Test City', state: 'Test State'}}]" />
        <munit:attributes value="#[{uriParams: {carrierCode: 'DELHIVERY'}, headers: {'x-api-key': Mule::p('secure::delhivery.webhook.api-key'), 'x-carrier-event-id': 'MUNIT-DEL-VALID-001'}}]" />
      </munit:set-event>
      <flow-ref name="post:\webhooks\carriers\(carrierCode):application\json:real-time-shipment-tracking-api-config" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[vars.event.carrierCode]" expected="#['DELHIVERY']" />
      <munit-tools:assert-equals actual="#[vars.event.normalisedMilestone]" expected="#['OUT_FOR_DELIVERY']" />
      <munit-tools:assert-equals actual="#[vars.event.trackingNumber]" expected="#['DL-MUNIT-VALID-001']" />
      <munit-tools:assert-equals actual="#[payload.duplicate]" expected="#[true]" />
    </munit:validation>
  </munit:test>
  <!-- BlueDart webhook: mock signature verification, then verify the carrier mapping. -->
  <munit:test name="webhook-bluedart-valid-event" description="Normalizes a BlueDart event after valid signature verification">
    <munit:behavior>
      <munit-tools:mock-when processor="java:invoke-static">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Invoke static" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:variables>
            <munit-tools:variable key="signatureValid" value="#[true]" />
          </munit-tools:variables>
        </munit-tools:then-return>
      </munit-tools:mock-when>
      <munit-tools:mock-when processor="db:select">
        <munit-tools:with-attributes>
          <munit-tools:with-attribute attributeName="doc:name" whereValue="Check Duplicate Event" />
        </munit-tools:with-attributes>
        <munit-tools:then-return>
          <munit-tools:payload value="#[[{event_seq: 1}]]" mediaType="application/java" />
        </munit-tools:then-return>
      </munit-tools:mock-when>
    </munit:behavior>
    <munit:execution>
      <munit:set-event cloneOriginalEvent="false">
        <munit:payload value="#[{awbNumber: 'BD-MUNIT-VALID-001', statusCode: 'OOD', scanLocation: {facilityCode: 'MUNIT', city: 'Test City', state: 'Test State'}}]" />
        <munit:attributes value="#[{uriParams: {carrierCode: 'BLUEDART'}, headers: {'x-carrier-signature': 'mock-signature', 'x-carrier-event-id': 'MUNIT-BD-VALID-001'}}]" />
      </munit:set-event>
      <flow-ref name="post:\webhooks\carriers\(carrierCode):application\json:real-time-shipment-tracking-api-config" />
    </munit:execution>
    <munit:validation>
      <munit-tools:assert-equals actual="#[vars.signatureValid]" expected="#[true]" />
      <munit-tools:assert-equals actual="#[vars.event.carrierCode]" expected="#['BLUEDART']" />
      <munit-tools:assert-equals actual="#[vars.event.normalisedMilestone]" expected="#['OUT_FOR_DELIVERY']" />
      <munit-tools:assert-equals actual="#[vars.event.trackingNumber]" expected="#['BD-MUNIT-VALID-001']" />
      <munit-tools:assert-equals actual="#[payload.duplicate]" expected="#[true]" />
    </munit:validation>
  </munit:test>
